# Admin paneli ortam değişkenleri — VPS'te .env olarak oluştur (git'e girmez).
# Admin giriş şifresi (zorunlu — güçlü bir şey seç):
ADMIN_PASSWORD=degistir-bunu
# Oturum çerezini imzalayan gizli anahtar (uzun, rastgele):
SESSION_SECRET=uzun-rastgele-bir-dize-uret
# SQLite dosya yolu (ops. — varsayılan: <proje>/data/vibes.db):
# DATABASE_PATH=/var/www/aizho/data/vibes.db
